  <ItemGroup>
    <Reference Include="Iris.Core"><HintPath>references/Iris.Core.dll</HintPath></Reference>
    <Reference Include="Iris.Infrastructure"><HintPath>references/Iris.Infrastructure.dll</HintPath></Reference>
    <Reference Include="Iris.Platform.Windows"><HintPath>references/Iris.Platform.Windows.dll</HintPath></Reference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>
</Project>
