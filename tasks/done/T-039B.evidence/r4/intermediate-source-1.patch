+
+    [Fact]
+    public async Task ShutdownFailureRecoveryRetainsCandidate_ClosesNetworkAdmission_AndAllowsRepeatedLocalPrepare()
+    {
+        using var directory = new TempDirectory();
+        var source = new Source { Package = PackageBytes() };
+        var settings = Substitute.For<ISettingsService>();
+        settings.Current.Returns(new AppSettings { General = new() { CheckForUpdates = false } });
+        var coordinator = new AppUpdateCoordinator(new Runtime(directory.Path, source), settings, new FakeTimeProvider());
+        coordinator.Start();
+
+        try
+        {
+            await coordinator.CheckAsync(this);
+            var offer = coordinator.Snapshot.OfferId!.Value;
+            await coordinator.DownloadAsync(this, offer);
+            var prepared = await coordinator.PrepareApplyAsync(this, offer, CancellationToken.None);
+            prepared.ShouldNotBeNull();
+
+            // This is the production stop boundary: acceptance is closed and the
+            // already prepared candidate is no longer a normal install button.
+            await coordinator.StopAsync();
+            coordinator.Snapshot.Phase.ShouldBe(UpdatePhase.Stopped);
+            coordinator.HasCandidate.ShouldBeFalse();
+            var stoppedCheck = coordinator.CheckAsync(this);
+            stoppedCheck.ShouldBe(Task.CompletedTask);
+            await stoppedCheck;
+            source.Requests.ShouldBe(1);
+
+            coordinator.RollbackLastApply(ErrorCode.Unknown).ShouldBeTrue();
+            coordinator.Snapshot.Phase.ShouldBe(UpdatePhase.Failed);
+            coordinator.HasCandidate.ShouldBeTrue();
+            coordinator.IsRecoveryAvailable.ShouldBeTrue();
+
+            // Recovery never reopens the stopped feed/download path.
+            await coordinator.CheckAsync(this);
+            source.Requests.ShouldBe(1);
+
+            var firstRetry = await coordinator.PrepareApplyAsync(this, prepared!.Id, CancellationToken.None);
+            firstRetry.ShouldNotBeNull();
+            coordinator.RollbackApply(firstRetry!, ErrorCode.Timeout);
+            coordinator.Snapshot.Phase.ShouldBe(UpdatePhase.Failed);
+            coordinator.HasCandidate.ShouldBeTrue();
+
+            // A second handoff failure still leaves the same candidate owned by
+            // the recovery path, and a later local validation can succeed.
+            var secondRetry = await coordinator.PrepareApplyAsync(this, prepared.Id, CancellationToken.None);
+            secondRetry.ShouldNotBeNull();
+            coordinator.RollbackApply(secondRetry!, ErrorCode.Unknown);
+            var successfulRetry = await coordinator.PrepareApplyAsync(this, prepared.Id, CancellationToken.None);
+            successfulRetry.ShouldNotBeNull();
+            source.Requests.ShouldBe(1);
+        }
+        finally
+        {
+            await coordinator.StopAsync();
+        }
+    }
