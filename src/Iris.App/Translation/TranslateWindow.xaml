<ui:FluentWindow x:Class="Iris.App.Translation.TranslateWindow"
                 x:ClassModifier="internal"
                 ExtendsContentIntoTitleBar="True"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:Iris.App"
                 xmlns:local="clr-namespace:Iris.App.Translation"
                 Title="{x:Static app:UiText.TranslateWindowTitle}"
                 Width="{Binding WindowWidth, FallbackValue=460}"
                 MinWidth="280"
                 MaxWidth="1200"
                 Height="480"
                 MinHeight="300"
                 Topmost="{Binding Topmost, FallbackValue=False}"
                 WindowStartupLocation="Manual"
                 ShowInTaskbar="False"
                 Closing="OnWindowClosing"
                 Activated="OnWindowActivated"
                 Deactivated="OnWindowDeactivated"
                 IsVisibleChanged="OnWindowIsVisibleChanged"
                 PreviewKeyDown="OnWindowPreviewKeyDown"
                 LocationChanged="OnWindowLocationChanged"
                 SizeChanged="OnWindowSizeChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="{DynamicResource IrisAcrylicTintBrush}">
        <DockPanel Margin="12,8,12,12">
            <!-- Top bar: source language + detected label, drag spacer, pin + settings -->
            <Grid DockPanel.Dock="Top"
                  Margin="0,0,0,8"
                  Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ComboBox x:Name="SourceLangComboBox"
                              Style="{StaticResource IrisGhostComboBox}"
                              MaxWidth="148"
                              ItemsSource="{Binding AvailableSourceLanguages}"
                              SelectedValue="{Binding SourceLanguage, Mode=TwoWay}"
                              SelectedValuePath="Code"
                              AutomationProperties.Name="{x:Static app:UiText.AccessibilitySourceLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock x:Name="DetectedSourceLanguageTextBlock"
                               Text="{Binding DetectedSourceLanguageText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="72"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasDetectedSourceLanguage, Converter={StaticResource BoolToVis}}"
                               ToolTip="{Binding DetectedSourceLanguageText}" />
                </StackPanel>

                <Border Grid.Column="1"
                        MinWidth="12"
                        Background="Transparent" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:Button x:Name="PinButton"
                               Width="28"
                               Height="28"
                               Margin="0,0,2,0"
                               Command="{Binding PinCommand}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource IrisIconButton}">
                                <Setter Property="Icon" Value="{ui:SymbolIcon Pin16}" />
                                <Setter Property="Content" Value="{x:Static app:UiText.TranslatePinWindow}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Icon" Value="{ui:SymbolIcon Pin16, Filled=True}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Property="Content" Value="{x:Static app:UiText.TranslateUnpinWindow}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ui:Button x:Name="SettingsButton"
                               Style="{StaticResource IrisIconButton}"
                               Width="28"
                               Height="28"
                               Icon="{ui:SymbolIcon Settings16}"
                               Content="{x:Static app:UiText.TranslateSettings}"
                               Command="{Binding GoToSettingsCommand}" />
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <ScrollViewer x:Name="ContentScrollViewer"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Source Text Card -->
                    <Border Grid.Row="0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource IrisCompactCard}">
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBox x:Name="InputTextBox"
                                         Style="{StaticResource IrisBorderlessTextBox}"
                                         AutomationProperties.Name="{x:Static app:UiText.AccessibilitySourceText}"
                                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="48"
                                         MaxHeight="200"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="{Binding FontSize, FallbackValue=14}"
                                         PreviewKeyDown="OnInputTextBoxPreviewKeyDown" />

                                <TextBlock x:Name="InputPlaceholderTextBlock"
                                           IsHitTestVisible="False"
                                           Text="{x:Static app:UiText.TranslateInputPlaceholder}"
                                           FontSize="{Binding FontSize, FallbackValue=14}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="2,1,2,0"
                                           VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InputLength}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,6,0,0"
                                  MinHeight="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:Button x:Name="StopButton"
                                               Grid.Column="0"
                                               Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}"
                                               Command="{Binding StopCommand}"
                                               Content="{x:Static app:UiText.TranslateStopButton}"
                                               Icon="{ui:SymbolIcon Stop16}"
                                               Appearance="Secondary"
                                               Padding="8,3"
                                               FontSize="12"
                                               Margin="0,0,6,0"
                                               AutomationProperties.Name="{x:Static app:UiText.TranslateStopButton}" />

                                    <TextBlock x:Name="InputValidationErrorTextBlock"
                                               Grid.Column="1"
                                               Text="{Binding Error.Message}"
                                               Visibility="{Binding IsInputValidationError, Converter={StaticResource BoolToVis}}"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />

                                    <TextBlock x:Name="StatusMessageTextBlock"
                                               Grid.Column="1"
                                               Text="{Binding StatusMessage}"
                                               Visibility="{Binding HasVisibleStatus, Converter={StaticResource BoolToVis}}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock x:Name="InputCharCountTextBlock"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="8,0,0,0"
                                           FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInputTooLong}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} / {1}">
                                            <Binding Path="InputLength" />
                                            <Binding Path="MaxInputChars" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Row 1: Target Language Divider Row -->
                    <Grid Grid.Row="1" Margin="0,10,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:Button x:Name="SwapLanguagesButton"
                                   Grid.Column="0"
                                   Style="{StaticResource IrisIconButton}"
                                   Width="28"
                                   Height="28"
                                   Icon="{ui:SymbolIcon ArrowSwap20, FontSize=14}"
                                   Content="{x:Static app:UiText.TranslateSwapLanguages}"
                                   Command="{Binding SwapLanguagesCommand}" />

                        <TextBlock x:Name="TargetLanguageLabelTextBlock"
                                   Grid.Column="1"
                                   Text="{x:Static app:UiText.TranslateTo}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,4,0" />

                        <ComboBox x:Name="TargetLangComboBox"
                                  Grid.Column="2"
                                  Style="{StaticResource IrisGhostComboBox}"
                                  MaxWidth="184"
                                  ItemsSource="{Binding AvailableTargetLanguages}"
                                  SelectedValue="{Binding TargetLanguage, Mode=TwoWay}"
                                  SelectedValuePath="Code"
                                  AutomationProperties.Name="{x:Static app:UiText.AccessibilityTargetLanguage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Grid.Column="3"
                                Height="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </Grid>

                    <!-- Row 2: Results Area -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="GeneralErrorBorder"
                                Grid.Row="0"
                                Style="{StaticResource IrisCompactCard}"
                                Margin="0,0,0,8"
                                Visibility="{Binding HasGeneralError, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="ErrorCircle16"
                                               FontSize="14"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               Margin="0,2,8,0"
                                               VerticalAlignment="Top" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Error.Message}"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />

                                <ui:Button Grid.Column="2"
                                           Content="{x:Static app:UiText.TranslateGoToSettings}"
                                           Command="{Binding GoToSettingsCommand}"
                                           Visibility="{Binding ShowGoToSettingsForError, Converter={StaticResource BoolToVis}}"
                                           Padding="8,3"
                                           FontSize="11"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      x:Name="CardsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cards.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ProviderResultCardViewModel}">
                                        <Border Style="{StaticResource IrisCompactCard}"
                                               Margin="0,0,0,8"
                                               Padding="0"
                                               ClipToBounds="True">
                                            <StackPanel>
                                                <!-- Top 2px streaming indicator bar (always 2px tall to prevent height jump) -->
                                                <Border Height="2"
                                                        Margin="8,0,8,0"
                                                        CornerRadius="0,0,1,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <Grid Margin="12,8,12,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Card Header -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <WrapPanel Grid.Column="0"
                                                                   Orientation="Horizontal"
                                                                   VerticalAlignment="Center">
                                                            <Border Width="18"
                                                                    Height="18"
                                                                    CornerRadius="4"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Opacity" Value="1.0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.HasStaleResults, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="True">
                                                                                <Setter Property="Opacity" Value="0.52" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding ProviderInitial}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </Border>

                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12.5"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="160"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Opacity" Value="1.0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.HasStaleResults, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="True">
                                                                                <Setter Property="Opacity" Value="0.52" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Text="{Binding Model}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="160"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Opacity" Value="1.0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.HasStaleResults, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="True">
                                                                                <Setter Property="Opacity" Value="0.52" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Model}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Model}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Text="{Binding ElapsedText}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Opacity" Value="1.0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.HasStaleResults, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="True">
                                                                                <Setter Property="Opacity" Value="0.52" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ElapsedText}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ElapsedText}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <Border Margin="0,0,4,0"
                                                                    Visibility="{Binding FromCache, Converter={StaticResource BoolToVis}}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource IrisTag}">
                                                                        <Setter Property="Opacity" Value="1.0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.HasStaleResults, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="True">
                                                                                <Setter Property="Opacity" Value="0.52" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Style="{StaticResource IrisTagText}"
                                                                           Text="{x:Static app:UiText.TranslateFromCache}" />
                                                            </Border>

                                                            <Border Style="{StaticResource IrisTag}"
                                                                    Margin="0,0,4,0"
                                                                    Visibility="{Binding DataContext.HasStaleResults, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Style="{StaticResource IrisTagText}"
                                                                           Text="{x:Static app:UiText.TranslateLastResult}" />
                                                            </Border>
                                                        </WrapPanel>

                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Top"
                                                                    Margin="6,0,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.HasStaleResults, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.52" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <ui:Button Style="{StaticResource IrisIconButton}"
                                                                       Width="26"
                                                                       Height="26"
                                                                       Icon="{ui:SymbolIcon Copy16}"
                                                                       Content="{x:Static app:UiText.TranslateCopy}"
                                                                       Command="{Binding CopyCommand}"
                                                                       IsEnabled="{Binding CanCopy}"
                                                                       ToolTip="{Binding CopyTooltip}"
                                                                       AutomationProperties.Name="{Binding CopyTooltip}" />

                                                            <ui:Button Style="{StaticResource IrisIconButton}"
                                                                       Width="26"
                                                                       Height="26"
                                                                       Margin="2,0,0,0"
                                                                       Icon="{ui:SymbolIcon ArrowClockwise16}"
                                                                       Content="{x:Static app:UiText.TranslateRetry}"
                                                                       Command="{Binding RetryCommand}"
                                                                       Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Warnings & Card Error -->
                                                    <StackPanel Grid.Row="1">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Opacity" Value="1.0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.HasStaleResults, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.52" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <DockPanel Margin="0,0,0,4"
                                                                   Visibility="{Binding IsLocallyTruncated, Converter={StaticResource BoolToVis}}">
                                                            <ui:SymbolIcon DockPanel.Dock="Left"
                                                                           Symbol="Warning16"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                           Margin="0,2,5,0"
                                                                           VerticalAlignment="Top" />
                                                            <TextBlock Text="{x:Static app:UiText.TranslateLocalTruncated}"
                                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                       FontSize="11.5"
                                                                       TextWrapping="Wrap" />
                                                        </DockPanel>

                                                        <DockPanel Margin="0,0,0,4"
                                                                   Visibility="{Binding IsModelTruncated, Converter={StaticResource BoolToVis}}">
                                                            <ui:SymbolIcon DockPanel.Dock="Left"
                                                                           Symbol="Warning16"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                           Margin="0,2,5,0"
                                                                           VerticalAlignment="Top" />
                                                            <TextBlock Text="{x:Static app:UiText.TranslateModelTruncated}"
                                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                       FontSize="11.5"
                                                                       TextWrapping="Wrap" />
                                                        </DockPanel>

                                                        <Grid Margin="0,0,0,4"
                                                              Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <ui:SymbolIcon Grid.Column="0"
                                                                           Symbol="ErrorCircle16"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                                           Margin="0,2,5,0"
                                                                           VerticalAlignment="Top" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ErrorMessage}"
                                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center" />

                                                            <ui:Button Grid.Column="2"
                                                                       Content="{x:Static app:UiText.TranslateGoToSettings}"
                                                                       Command="{Binding GoToSettingsCommand}"
                                                                       Visibility="{Binding ShowGoToSettings, Converter={StaticResource BoolToVis}}"
                                                                       Padding="6,2"
                                                                       FontSize="11"
                                                                       Margin="6,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Translated Text -->
                                                    <TextBox Grid.Row="2"
                                                             Text="{Binding Text, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"
                                                             UndoLimit="0"
                                                             FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource IrisBorderlessTextBox}">
                                                                <Setter Property="Opacity" Value="1.0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.HasStaleResults, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.52" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
