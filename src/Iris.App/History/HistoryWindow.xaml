<ui:FluentWindow x:Class="Iris.App.History.HistoryWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:Iris.App"
                 xmlns:local="clr-namespace:Iris.App.History"
                 Title="{x:Static app:UiText.HistoryTitle}"
                 Width="800"
                 Height="640"
                 MinWidth="280"
                 MinHeight="240"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="{DynamicResource IrisAcrylicTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{x:Static app:UiText.HistoryTitle}" ShowMaximize="True" />

        <ScrollViewer x:Name="HistoryScroll"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="ContentHostGrid" Margin="16,2,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumnDefinition" Width="324" />
                    <ColumnDefinition x:Name="RightColumnDefinition" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="MainRowDefinition" Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="ConfirmationPanel"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource IrisCompactCard}"
                        Margin="0,0,0,10"
                        Visibility="{Binding HasConfirmation, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:SymbolIcon Grid.Row="0"
                                       Grid.Column="0"
                                       Symbol="Warning16"
                                       FontSize="15"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                        <TextBlock x:Name="ConfirmationMessageTextBlock"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding ConfirmationText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />

                        <WrapPanel x:Name="ConfirmationActionsPanel"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Orientation="Horizontal"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center">
                            <CheckBox x:Name="KeepFavoritesCheckBox"
                                      IsChecked="{Binding KeepFavorites}"
                                      IsEnabled="{Binding CanInteract}"
                                      Visibility="{Binding IsClearConfirmation, Converter={StaticResource BoolToVis}}"
                                      Margin="0,2,12,2"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{x:Static app:UiText.HistoryKeepFavorites}" TextWrapping="Wrap" />
                            </CheckBox>
                            <ui:Button x:Name="ConfirmButton"
                                       Content="{x:Static app:UiText.HistoryConfirm}"
                                       Command="{Binding ConfirmCommand}"
                                       Appearance="Primary"
                                       Padding="12,5"
                                       Margin="0,2,6,2" />
                            <ui:Button x:Name="CancelConfirmationButton"
                                       Content="{x:Static app:UiText.HistoryCancel}"
                                       Command="{Binding CancelConfirmationCommand}"
                                       Padding="12,5"
                                       Margin="0,2,0,2" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Grid x:Name="LeftPane"
                      Grid.Row="1"
                      Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            MinHeight="32"
                            Padding="8,0"
                            CornerRadius="5"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="Search16"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />

                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchTextBox"
                                         Style="{StaticResource IrisBorderlessTextBox}"
                                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanInteract}"
                                         VerticalContentAlignment="Center"
                                         Padding="0,5"
                                         AutomationProperties.Name="{x:Static app:UiText.HistorySearch}" />

                                <TextBlock IsHitTestVisible="False"
                                           Text="{x:Static app:UiText.HistorySearch}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <WrapPanel Grid.Row="1" Margin="0,8,0,4">
                        <CheckBox x:Name="FavoritesCheckBox"
                                  Style="{StaticResource IrisPillCheckBox}"
                                  Content="{x:Static app:UiText.HistoryFavoritesOnly}"
                                  IsChecked="{Binding FavoritesOnly}"
                                  IsEnabled="{Binding CanInteract}"
                                  Margin="0,0,6,4" />
                        <ui:Button x:Name="RefreshButton"
                                   Icon="{ui:SymbolIcon ArrowClockwise16}"
                                   Content="{x:Static app:UiText.HistoryRefresh}"
                                   Command="{Binding RefreshCommand}"
                                   Padding="10,4"
                                   FontSize="12.5"
                                   MinHeight="28"
                                   Margin="0,0,6,4" />
                        <ui:Button x:Name="ClearButton"
                                   Icon="{ui:SymbolIcon Delete16}"
                                   Content="{x:Static app:UiText.HistoryClear}"
                                   Command="{Binding ClearCommand}"
                                   Padding="10,4"
                                   FontSize="12.5"
                                   MinHeight="28"
                                   Margin="0,0,0,4" />
                    </WrapPanel>

                    <StackPanel x:Name="StatusStack" Grid.Row="2">
                        <TextBlock Text="{x:Static app:UiText.HistoryLoading}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                   TextWrapping="Wrap"
                                   Margin="4,4,4,8" />

                        <TextBlock Text="{Binding ListError}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap"
                                   Margin="4,4,4,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{x:Static app:UiText.HistoryEmpty}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                                   TextWrapping="Wrap"
                                   Margin="4,4,4,8" />
                    </StackPanel>

                    <ListBox x:Name="HistoryList"
                             Grid.Row="3"
                             ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedRow}"
                             IsEnabled="{Binding CanInteract}"
                             ItemContainerStyle="{StaticResource IrisHistoryListItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HistoryRow}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Preview}"
                                               FontSize="13"
                                               LineHeight="18"
                                               MaxHeight="36"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                    <TextBlock Text="{Binding Metadata}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding Metadata}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Summary.IsFavorite}" Value="False" />
                                                            <Condition Binding="{Binding Summary.HasTruncatedResults}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border Style="{StaticResource IrisTag}"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding Summary.IsFavorite, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Star16"
                                                               Filled="True"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                               Margin="0,0,4,0"
                                                               VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource IrisTagText}"
                                                           Text="{x:Static app:UiText.HistoryFavorite}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource IrisTag}"
                                                Visibility="{Binding Summary.HasTruncatedResults, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Warning16"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                               Margin="0,0,4,0"
                                                               VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource IrisTagText}"
                                                           Text="{x:Static app:UiText.HistoryTruncated}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:Button x:Name="PreviousButton"
                                   Grid.Column="0"
                                   Style="{StaticResource IrisIconButton}"
                                   Width="30"
                                   Height="30"
                                   Icon="{ui:SymbolIcon ChevronLeft16}"
                                   Content="{x:Static app:UiText.HistoryPrevious}"
                                   Command="{Binding PreviousCommand}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding PageLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="6,0"
                                   ToolTip="{Binding PageLabel}" />

                        <ui:Button x:Name="NextButton"
                                   Grid.Column="2"
                                   Style="{StaticResource IrisIconButton}"
                                   Width="30"
                                   Height="30"
                                   Icon="{ui:SymbolIcon ChevronRight16}"
                                   Content="{x:Static app:UiText.HistoryNext}"
                                   Command="{Binding NextCommand}" />
                    </Grid>
                </Grid>

                <Border x:Name="RightPane"
                        Grid.Row="1"
                        Grid.Column="1"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Margin="14,0,0,0"
                        Padding="14,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="UnselectedHintTextBlock"
                                   Grid.RowSpan="2"
                                   Text="{x:Static app:UiText.HistorySelect}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <WrapPanel Grid.Row="0"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <ui:Button x:Name="FavoriteButton"
                                       Command="{Binding FavoriteCommand}"
                                       Content="{Binding FavoriteLabel}"
                                       Padding="10,4"
                                       FontSize="12.5"
                                       MinHeight="30"
                                       Margin="0,0,6,4">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Icon" Value="{ui:SymbolIcon Star16}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRow.Summary.IsFavorite}" Value="True">
                                                <Setter Property="Icon">
                                                    <Setter.Value>
                                                        <ui:SymbolIcon Symbol="Star16"
                                                                       Filled="True"
                                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <ui:Button x:Name="RetranslateButton"
                                       Icon="{ui:SymbolIcon Translate16}"
                                       Content="{x:Static app:UiText.HistoryRetranslate}"
                                       Command="{Binding RetranslateCommand}"
                                       Padding="10,4"
                                       FontSize="12.5"
                                       MinHeight="30"
                                       Margin="0,0,6,4" />

                            <ui:Button x:Name="DeleteButton"
                                       Icon="{ui:SymbolIcon Delete16}"
                                       Content="{x:Static app:UiText.HistoryDelete}"
                                       Command="{Binding DeleteCommand}"
                                       Padding="10,4"
                                       FontSize="12.5"
                                       MinHeight="30"
                                       Margin="0,0,0,4" />
                        </WrapPanel>

                        <ScrollViewer x:Name="DetailScroll"
                                      Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{x:Static app:UiText.HistoryDetailsLoading}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVis}}"
                                           Margin="0,4,0,8"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="{Binding DetailError}"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <Trigger Property="Text" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel x:Name="DetailPanel"
                                            Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource IrisCompactCard}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Static app:UiText.HistorySource}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />

                                                <ui:Button x:Name="CopySourceButton"
                                                           Grid.Column="1"
                                                           Style="{StaticResource IrisIconButton}"
                                                           Width="28"
                                                           Height="28"
                                                           Icon="{ui:SymbolIcon Copy16}"
                                                           Content="{x:Static app:UiText.HistoryCopySource}"
                                                           Command="{Binding CopySourceCommand}" />
                                            </Grid>

                                            <TextBox x:Name="SourceTextBox"
                                                     Grid.Row="1"
                                                     Style="{StaticResource IrisBorderlessTextBox}"
                                                     Text="{Binding Detail.SourceText, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     FontSize="13.5"
                                                     UndoLimit="0" />
                                        </Grid>
                                    </Border>

                                    <ItemsControl x:Name="ResultsList"
                                                  ItemsSource="{Binding Detail.Results}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource IrisCompactCard}" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProviderName}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12.5"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="180"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0" />

                                                                <TextBlock Text="{Binding Model}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="180"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <Trigger Property="Text" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </Trigger>
                                                                                <Trigger Property="Text" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <Border Style="{StaticResource IrisTag}"
                                                                        Visibility="{Binding Truncated, Converter={StaticResource BoolToVis}}"
                                                                        Margin="0,0,6,0"
                                                                        VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon Symbol="Warning16"
                                                                                       FontSize="10"
                                                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                                       Margin="0,0,4,0"
                                                                                       VerticalAlignment="Center" />
                                                                        <TextBlock Style="{StaticResource IrisTagText}"
                                                                                   Text="{x:Static app:UiText.HistoryTruncated}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </WrapPanel>

                                                            <ui:Button Grid.Column="1"
                                                                       Style="{StaticResource IrisIconButton}"
                                                                       Width="28"
                                                                       Height="28"
                                                                       Icon="{ui:SymbolIcon Copy16}"
                                                                       Content="{x:Static app:UiText.HistoryCopyResult}"
                                                                       Command="{Binding DataContext.CopyResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding ProviderId}" />
                                                        </Grid>

                                                        <TextBox Grid.Row="1"
                                                                 Style="{StaticResource IrisBorderlessTextBox}"
                                                                 Text="{Binding Text, Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 TextWrapping="Wrap"
                                                                 FontSize="13.5"
                                                                 UndoLimit="0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Status}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0" />

                <ui:Button x:Name="CloseButton"
                           Grid.Column="1"
                           Content="{x:Static app:UiText.HistoryClose}"
                           Command="{Binding CloseCommand}"
                           MinWidth="80"
                           Padding="14,5" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
