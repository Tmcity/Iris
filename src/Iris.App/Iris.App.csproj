<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Icons\iris.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iris.Core\Iris.Core.csproj" />
    <ProjectReference Include="..\Iris.Providers\Iris.Providers.csproj" />
    <ProjectReference Include="..\Iris.Infrastructure\Iris.Infrastructure.csproj" />
    <ProjectReference Include="..\Iris.Platform.Windows\Iris.Platform.Windows.csproj" />
    <ProjectReference Include="..\Iris.UiaHost\Iris.UiaHost.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Iris.Maintenance\Iris.Maintenance.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyUiaHostToOutput" AfterTargets="Build">
    <PropertyGroup><_UiaOutput>..\Iris.UiaHost\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</_UiaOutput></PropertyGroup>
    <ItemGroup>
      <_UiaHostFiles Include="$(_UiaOutput)*.*;$(_UiaOutput)en-US\*.*;$(_UiaOutput)runtimes\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_UiaHostFiles)" DestinationFiles="@(_UiaHostFiles->'$(TargetDir)uia\$([MSBuild]::MakeRelative($(_UiaOutput), %(Identity)))')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyUiaHostToPublish" AfterTargets="Publish">
    <MSBuild Projects="..\Iris.UiaHost\Iris.UiaHost.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false;PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)uia\'))" />
  </Target>

  <ItemGroup>
    <!-- 使用自定义 Program.Main：App.xaml 不再作为 ApplicationDefinition 自动生成 Main -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Resources\Icons\iris.ico" />
    <InternalsVisibleTo Include="Iris.App.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>
</Project>
