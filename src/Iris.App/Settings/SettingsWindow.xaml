                                        </Style>
                                    </StackPanel.Style>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock TextWrapping="Wrap" Text="{x:Static app:UiText.SettingsEffort}" Width="120" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedValue="{Binding Effort, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  MaxWidth="140"
                                                  HorizontalAlignment="Left">
                                            <ComboBoxItem Tag="{x:Null}" Content="{x:Static app:UiText.Text_28293356d695}" />
                                            <ComboBoxItem Tag="low" Content="low" />
                                            <ComboBoxItem Tag="medium" Content="medium" />
                                            <ComboBoxItem Tag="high" Content="high" />
                                            <ComboBoxItem Tag="xhigh" Content="xhigh" />
                                            <ComboBoxItem Tag="max" Content="max" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Haiku Effort 提示 -->
                                    <TextBlock Text="{x:Static app:UiText.SettingsHaikuEffortWarning}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               FontSize="11"
                                               Margin="120,0,0,8"
                                               Visibility="{Binding HasHaikuEffortWarning, Converter={StaticResource BoolToVis}}"
                                               TextWrapping="Wrap" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.SettingsRefusalFallback}" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" Style="{StaticResource IrisSwitchCheckBox}" VerticalAlignment="Center"
                                                  IsChecked="{Binding RefusalFallback, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Static app:UiText.SettingsRefusalFallback}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="SelectionScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="selection">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="{StaticResource IrisPagePadding}" IsEnabled="{Binding CanEdit}">
                    <TextBlock Style="{StaticResource IrisPageTitle}" Text="{x:Static app:UiText.SettingsNavSelection}" />
                    <TextBlock x:Name="SelectionErrorTextBlock" Text="{Binding Selection.ErrorMessage}" TextWrapping="Wrap"
                               Visibility="{Binding Selection.HasError, Converter={StaticResource BoolToVis}}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="{StaticResource IrisCardGap}" />

                    <Border Style="{StaticResource IrisRowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="CursorClick20" Style="{StaticResource IrisRowIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.MouseModeLabel}" />
                                <TextBlock Style="{StaticResource IrisRowDescription}" Text="{x:Static app:UiText.MouseExplanation}" />
                            </StackPanel>
                            <ComboBox x:Name="MouseModeComboBox" Grid.Column="2" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center" MinWidth="160"
                                      ItemsSource="{x:Static local:SelectionSettingsDraftViewModel.MouseModes}"
                                      DisplayMemberPath="Label" SelectedValuePath="Mode" SelectedValue="{Binding Selection.MouseMode, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource IrisRowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="CursorHover20" Style="{StaticResource IrisRowIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.MouseBeamLabel}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center"
                                      Style="{StaticResource IrisSwitchCheckBox}"
                                      AutomationProperties.Name="{x:Static app:UiText.MouseBeamLabel}"
                                      IsChecked="{Binding Selection.RequireIBeamCursor, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource IrisRowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Cursor20" Style="{StaticResource IrisRowIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.MouseDragLabel}" />
                            </StackPanel>
                            <TextBox x:Name="MouseDragTextBox" Grid.Column="2" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center" Width="120"
                                     Text="{Binding Selection.MinDragDistanceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource IrisRowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Timer20" Style="{StaticResource IrisRowIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.MouseHideLabel}" />
                            </StackPanel>
                            <TextBox x:Name="MouseHideTextBox" Grid.Column="2" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center" Width="120"
                                     Text="{Binding Selection.IconAutoHideText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource IrisRowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:SymbolIcon Grid.Row="0" Grid.Column="0" Symbol="DismissSquare20" Style="{StaticResource IrisRowIcon}" />
                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.MouseExcludedLabel}" />
                            </StackPanel>
                            <TextBox x:Name="MouseExcludedTextBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                     Text="{Binding Selection.ExcludedProcessesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="130" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource IrisRowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Options20" Style="{StaticResource IrisRowIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.SelectionOrderLabel}" />
                                <TextBlock Style="{StaticResource IrisRowDescription}" Text="{x:Static app:UiText.SelectionSafetyDescription}" />
                            </StackPanel>
                            <ComboBox x:Name="SelectionOrderComboBox" Grid.Column="2" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center" MinWidth="160"
                                      ItemsSource="{x:Static local:SelectionSettingsDraftViewModel.Orders}"
                                      DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Selection.ReadOrderChoice, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource IrisRowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Options20" Style="{StaticResource IrisRowIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.SelectionTimeoutLabel}" />
                                <TextBlock Style="{StaticResource IrisRowDescription}" Text="{x:Static app:UiText.SelectionTimeoutDescription}" />
                            </StackPanel>
                            <TextBox x:Name="SelectionTimeoutTextBox" Grid.Column="2" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center" Width="120"
                                     Text="{Binding Selection.ClipboardTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource IrisRowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="ClipboardPaste20" Style="{StaticResource IrisRowIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.SelectionRestoreLabel}" />
                                <TextBlock Style="{StaticResource IrisRowDescription}" Text="{x:Static app:UiText.SelectionRestoreDescription}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center"
                                      Style="{StaticResource IrisSwitchCheckBox}"
                                      AutomationProperties.Name="{x:Static app:UiText.SelectionRestoreLabel}"
                                      IsChecked="{Binding Selection.RestoreClipboard, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource IrisRowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Clipboard20" Style="{StaticResource IrisRowIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.SelectionEmptyLabel}" />
                                <TextBlock Style="{StaticResource IrisRowDescription}" Text="{x:Static app:UiText.SelectionEmptyDescription}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center"
                                      Style="{StaticResource IrisSwitchCheckBox}"
                                      AutomationProperties.Name="{x:Static app:UiText.SelectionEmptyLabel}"
                                      IsChecked="{Binding Selection.OpenInputWhenEmpty, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource IrisRowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:SymbolIcon Grid.Row="0" Grid.Column="0" Symbol="ShieldKeyhole20" Style="{StaticResource IrisRowIcon}" />
                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.SelectionProcessesLabel}" />
                                <TextBlock Style="{StaticResource IrisRowDescription}" Text="{x:Static app:UiText.SelectionProcessesDescription}" />
                            </StackPanel>
                            <TextBox x:Name="SelectionProcessesTextBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                     Text="{Binding Selection.ClipboardUnsafeProcessesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="130" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧快捷键设置内容 -->
            <ScrollViewer x:Name="HotkeysPageScroll"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="hotkeys">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="{StaticResource IrisPagePadding}" IsEnabled="{Binding CanAccessHotkeysTab}">
                    <!-- 页面标题 -->
                    <TextBlock Style="{StaticResource IrisPageTitle}" Text="{x:Static app:UiText.SettingsNavHotkeys}" />
                    <TextBlock Style="{StaticResource IrisRowDescription}" Margin="{StaticResource IrisCardGap}"
                               Text="{x:Static app:UiText.SettingsHotkeysDescription}" />

                    <!-- 快捷键卡片列表 -->
                    <ItemsControl ItemsSource="{Binding Hotkeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HotkeyItemDraftViewModel}">
                                <Border Style="{StaticResource IrisRowCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 第一行：名称、描述与启用复选框 -->
                                        <ui:SymbolIcon Grid.Row="0" Grid.Column="0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource IrisRowIcon}">
                                                    <Setter Property="Symbol" Value="Keyboard20" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Action}" Value="{x:Static actions:IrisAction.InputTranslate}">
                                                            <Setter Property="Symbol" Value="Translate20" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="{x:Static actions:IrisAction.ClipboardTranslate}">
                                                            <Setter Property="Symbol" Value="ClipboardTextLtr20" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="{x:Static actions:IrisAction.OpenSettings}">
                                                            <Setter Property="Symbol" Value="Settings20" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="{x:Static actions:IrisAction.SelectionTranslate}">
                                                            <Setter Property="Symbol" Value="CursorClick20" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="{x:Static actions:IrisAction.ToggleMouseSelection}">
                                                            <Setter Property="Symbol" Value="CursorHover20" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource IrisRowTitle}" Text="{Binding DisplayName}" />
                                            <TextBlock Style="{StaticResource IrisRowDescription}" Text="{Binding Description}" />
                                        </StackPanel>
                                        <CheckBox Grid.Row="0" Grid.Column="2"
                                                  Style="{StaticResource IrisSwitchCheckBox}"
                                                  Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanEdit}"
                                                  AutomationProperties.Name="{Binding DisplayName}" />

                                        <!-- 第二行：录入控件 -->
                                        <local:HotkeyRecorderBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                                 Margin="0,8,0,0" MinWidth="360" HorizontalAlignment="Stretch" />

                                        <!-- 第三行：错误与状态提示 -->
                                        <!-- 草稿错误（冲突、非法键） -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                   Margin="0,6,0,0"
                                                   Text="{Binding DraftError}"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDraftError}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 运行时注册状态 -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding RuntimeStatusText}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRuntimeStatus}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部状态与操作栏 -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource IrisAcrylicCardStrokeBrush}"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 状态与异常重试提示 -->
                <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="StatusMessageTextBlock"
                               Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

<StackPanel Grid.Row="1">
                    <TextBlock Text="{x:Static app:UiText.SettingsFutureReadOnly}" TextWrapping="Wrap"
                               Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6" />
                    <TextBlock x:Name="MouseRuntimeStatusTextBlock" Grid.Row="1" Text="{Binding MouseRuntimeStatus}" TextWrapping="Wrap"
                               Margin="0,4,0,4" Visibility="{Binding HasMouseRuntimeStatus, Converter={StaticResource BoolToVis}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
<TextBlock x:Name="OcrTestStatusText" Text="{Binding OcrTestStatus}" TextWrapping="Wrap" Margin="0,4,0,4" Visibility="{Binding HasOcrTestStatus, Converter={StaticResource BoolToVis}}"/></StackPanel>
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NetworkRetryCleanupButton" Content="{x:Static app:UiText.NetworkRetryCleanup}" Command="{Binding RetryNetworkCleanupCommand}" Margin="0,0,6,0" Visibility="{Binding HasFailedNetworkCleanup, Converter={StaticResource BoolToVis}}"/>
                        <Button x:Name="OcrRetryCleanupButton" Content="{x:Static app:UiText.OcrRetryCleanup}" Command="{Binding RetryOcrCleanupCommand}" Margin="0,0,6,0" Visibility="{Binding HasFailedOcrCleanup, Converter={StaticResource BoolToVis}}"/>
                        <!-- 保存冲突时展示“重新载入”按钮 -->
                        <Button Content="{x:Static app:UiText.SettingsReload}"
                                Command="{Binding ReloadCommand}"
                                Margin="0,0,6,0" Visibility="{Binding IsConflict, Converter={StaticResource BoolToVis}}" />

                        <!-- 开机启动写入失败时展示“重试应用”按钮 -->
                        <Button Content="{x:Static app:UiText.SettingsRetry}"
                                Command="{Binding RetryAutoStartCommand}"
                                Margin="0,0,6,0" Visibility="{Binding CanRetryAutoStart, Converter={StaticResource BoolToVis}}" />

                        <!-- 服务待应用刷新/清理失败时展示“重试服务应用”按钮 -->
                        <Button Content="{x:Static app:UiText.SettingsRetryPendingApply}"
                                Command="{Binding RetryPendingApplyCommand}"
                                Margin="0,0,6,0" Visibility="{Binding CanRetryPendingApply, Converter={StaticResource BoolToVis}}" />

                        <!-- 快捷键系统注册或录入清理失败时展示“重试快捷键应用”按钮 -->
                        <Button Content="{x:Static app:UiText.SettingsRetryHotkeys}"
                                Command="{Binding RetryHotkeysCommand}" Visibility="{Binding CanRetryHotkeysOrCleanup, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{x:Static app:UiText.MouseRetry}" Command="{Binding RetryMouseCommand}" Margin="6,0,0,0"
                                Visibility="{Binding CanRetryMouse, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>
                </Grid>

                <!-- 操作按钮区 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <ui:Button Content="{x:Static app:UiText.SettingsCancel}"
                               Command="{Binding CancelCommand}"
                               IsCancel="True"
                               Width="80"
                               Margin="0,0,8,0" />
                    <ui:Button Content="{x:Static app:UiText.SettingsSave}"
                               Command="{Binding SaveCommand}"
                               Click="OnSaveButtonClick"
                               IsDefault="True"
                               Appearance="Primary"
                               Width="80" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
