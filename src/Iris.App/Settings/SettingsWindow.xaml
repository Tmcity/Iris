<ui:FluentWindow x:Class="Iris.App.Settings.SettingsWindow"
                 x:ClassModifier="internal"
                 ExtendsContentIntoTitleBar="True"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:Iris.App"
                 xmlns:settings="clr-namespace:Iris.Core.Settings;assembly=Iris.Core"
                xmlns:actions="clr-namespace:Iris.Core.Actions;assembly=Iris.Core"
                 xmlns:local="clr-namespace:Iris.App.Settings"
                 Title="{x:Static app:UiText.SettingsWindowTitle}"
                 Width="760"
                 Height="520"
                 MinWidth="600"
                 MinHeight="440"
                 WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Background="{DynamicResource IrisAcrylicTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static app:UiText.SettingsWindowTitle}"
                     ShowMaximize="False" />

        <!-- 主体区域：左侧导航与右侧内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumnDef" Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0"
                    Padding="6,12,6,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="NavTitleText"
                               TextWrapping="Wrap"
                               Text="{x:Static app:UiText.SettingsTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="8,0,0,12" />

                    <!-- 导航项：常规 -->
                    <Border x:Name="NavGeneral"
                            MouseLeftButtonUp="OnNavGeneralClick"
                            ToolTip="{x:Static app:UiText.SettingsNavGeneral}"
                            AutomationProperties.Name="{x:Static app:UiText.SettingsNavGeneral}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource IrisNavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="general">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="16" CornerRadius="2" Margin="-8,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="general">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Settings20" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Static app:UiText.SettingsNavGeneral}"
                                       Margin="12,0,0,0" FontWeight="Medium" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- 导航项：翻译服务 -->
                    <Border x:Name="NavTranslation"
                            MouseLeftButtonUp="OnNavTranslationClick"
                            ToolTip="{x:Static app:UiText.SettingsNavTranslation}"
                            AutomationProperties.Name="{x:Static app:UiText.SettingsNavTranslation}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource IrisNavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="translation">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="16" CornerRadius="2" Margin="-8,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="translation">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Translate20" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Static app:UiText.SettingsNavTranslation}"
                                       Margin="12,0,0,0" FontWeight="Medium" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- 导航项：快捷键 -->
                    <Border x:Name="NavHotkeys"
                            MouseLeftButtonUp="OnNavHotkeysClick"
                            ToolTip="{x:Static app:UiText.SettingsNavHotkeys}"
                            AutomationProperties.Name="{x:Static app:UiText.SettingsNavHotkeys}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource IrisNavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="hotkeys">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="16" CornerRadius="2" Margin="-8,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="hotkeys">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Keyboard20" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Static app:UiText.SettingsNavHotkeys}"
                                       Margin="12,0,0,0" FontWeight="Medium" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Border x:Name="NavSelection"
                            MouseLeftButtonUp="OnNavSelectionClick"
                            ToolTip="{x:Static app:UiText.SettingsNavSelection}"
                            AutomationProperties.Name="{x:Static app:UiText.SettingsNavSelection}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource IrisNavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="selection">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="16" CornerRadius="2" Margin="-8,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="selection">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <ui:SymbolIcon Grid.Column="0" Symbol="CursorClick20" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Static app:UiText.SettingsNavSelection}"
                                       Margin="12,0,0,0" FontWeight="Medium" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Border x:Name="NavOcr"
                            MouseLeftButtonUp="OnNavOcrClick"
                            ToolTip="{x:Static app:UiText.OcrPageTitle}"
                            AutomationProperties.Name="{x:Static app:UiText.OcrPageTitle}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource IrisNavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="ocr">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="16" CornerRadius="2" Margin="-8,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="ocr">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <ui:SymbolIcon Grid.Column="0" Symbol="ScanText20" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Static app:UiText.OcrPageTitle}"
                                       Margin="12,0,0,0" FontWeight="Medium" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Border x:Name="NavScreenshot"
                            MouseLeftButtonUp="OnNavScreenshotClick"
                            ToolTip="{x:Static app:UiText.ScreenshotPageTitle}"
                            AutomationProperties.Name="{x:Static app:UiText.ScreenshotPageTitle}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource IrisNavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="screenshot">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="16" CornerRadius="2" Margin="-8,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="screenshot">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Screenshot20" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Static app:UiText.ScreenshotPageTitle}"
                                       Margin="12,0,0,0" FontWeight="Medium" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Border x:Name="NavNetwork"
                            MouseLeftButtonUp="OnNavNetworkClick"
                            ToolTip="{x:Static app:UiText.NetworkTitle}"
                            AutomationProperties.Name="{x:Static app:UiText.NetworkTitle}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource IrisNavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="network">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="16" CornerRadius="2" Margin="-8,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="network">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Globe20" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Static app:UiText.NetworkTitle}"
                                       Margin="12,0,0,0" FontWeight="Medium" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Border x:Name="NavHistory"
                            MouseLeftButtonUp="OnNavHistoryClick"
                            ToolTip="{x:Static app:UiText.HistoryTitle}"
                            AutomationProperties.Name="{x:Static app:UiText.HistoryTitle}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource IrisNavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="history">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="16" CornerRadius="2" Margin="-8,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="history">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <ui:SymbolIcon Grid.Column="0" Symbol="History20" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Static app:UiText.HistoryTitle}"
                                       Margin="12,0,0,0" FontWeight="Medium" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <ScrollViewer x:Name="NetworkPageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="network">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="{StaticResource IrisPagePadding}">
                    <TextBlock Style="{StaticResource IrisPageTitle}" Text="{x:Static app:UiText.NetworkTitle}" />
                    <TextBlock Style="{StaticResource IrisRowDescription}" Margin="{StaticResource IrisCardGap}" Text="{x:Static app:UiText.NetworkDescription}" />
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <Border Style="{StaticResource IrisRowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Style="{StaticResource IrisRowIcon}" Symbol="Globe20" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.NetworkModeLabel}" />
                                </StackPanel>
                                <ComboBox x:Name="NetworkModeCombo" Grid.Column="2" MinWidth="160" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center" ItemsSource="{x:Static local:NetworkSettingsDraftViewModel.Modes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Network.Mode.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource IrisRowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Style="{StaticResource IrisRowIcon}" Symbol="GlobeProhibited20" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.NetworkBypass}" />
                                    <TextBlock Style="{StaticResource IrisRowDescription}" Text="{x:Static app:UiText.NetworkBypassDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="NetworkBypassCheck" Grid.Column="2" Style="{StaticResource IrisSwitchCheckBox}" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center" IsChecked="{Binding Network.BypassLocal.Value}" AutomationProperties.Name="{x:Static app:UiText.NetworkBypass}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource IrisRowCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Style="{StaticResource IrisRowIcon}" Symbol="Server20" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.NetworkUrlLabel}" />
                                    <TextBlock Style="{StaticResource IrisRowDescription}" Text="{x:Static app:UiText.NetworkUrlHint}" />
                                </StackPanel>
                                <TextBox x:Name="NetworkUrlTextBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" Text="{Binding Network.Url.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" HorizontalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource IrisRowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Style="{StaticResource IrisRowIcon}" Symbol="Key20" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.NetworkCredentialLabel}" />
                                    <TextBlock Style="{StaticResource IrisRowDescription}" Text="{x:Static app:UiText.NetworkCredentialHint}" />
                                </StackPanel>
                                <ComboBox x:Name="NetworkCredentialsCombo" Grid.Column="2" MinWidth="160" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center" ItemsSource="{x:Static local:NetworkSettingsDraftViewModel.CredentialKinds}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Network.Credentials.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" />
                            </Grid>
                        </Border>
                        <StackPanel IsEnabled="{Binding Network.IsReplacing}">
                            <Border Style="{StaticResource IrisRowCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Style="{StaticResource IrisRowIcon}" Symbol="Key20" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.NetworkUserName}" />
                                    </StackPanel>
                                    <TextBox x:Name="NetworkUserNameTextBox" Grid.Column="2" Width="200" MinHeight="32" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center" Text="{Binding Network.UserName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource IrisRowCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Style="{StaticResource IrisRowIcon}" Symbol="Key20" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.NetworkPassword}" />
                                    </StackPanel>
                                    <PasswordBox x:Name="NetworkPasswordBox" Grid.Column="2" Width="200" MinHeight="32" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center" PasswordChanged="OnNetworkPasswordChanged" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="NetworkValidationText" Style="{StaticResource IrisRowError}" Margin="{StaticResource IrisCardGap}" Text="{Binding Network.ErrorMessage}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <Border Style="{StaticResource IrisCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource IrisRowTitle}" Margin="0,0,0,6" Text="{x:Static app:UiText.NetworkTargetLabel}" />
                            <ComboBox x:Name="NetworkEndpointCombo" ItemsSource="{Binding NetworkEndpoints}" SelectedItem="{Binding SelectedNetworkEndpoint, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" MinHeight="32">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="320" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource IrisStatusText}" Margin="0,6,0,4" Text="{Binding NetworkEndpointHint}" />
                            <TextBlock Style="{StaticResource IrisRowDescription}" Margin="0,0,0,10" Text="{x:Static app:UiText.NetworkTargetHint}" />
                            <WrapPanel>
                                <Button x:Name="NetworkTestButton" Content="{x:Static app:UiText.NetworkTest}" Command="{Binding TestNetworkCommand}" Margin="0,0,8,8" />
                                <Button x:Name="NetworkCancelButton" Content="{x:Static app:UiText.NetworkCancel}" Command="{Binding CancelNetworkCommand}" Margin="0,0,0,8" />
                            </WrapPanel>
                            <TextBlock x:Name="NetworkStatusText" Style="{StaticResource IrisStatusText}" Margin="0,4,0,8" Text="{Binding NetworkTestStatus}" Visibility="{Binding HasNetworkStatus, Converter={StaticResource BoolToVis}}" />
                            <TextBlock x:Name="NetworkResultText" Style="{StaticResource IrisStatusText}" Margin="0,4,0,12" Text="{Binding NetworkResultText}" Visibility="{Binding HasNetworkResult, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="HistoryPageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="history"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                <StackPanel IsEnabled="{Binding CanEdit}" Margin="{StaticResource IrisPagePadding}">
                    <TextBlock Style="{StaticResource IrisPageTitle}" Text="{x:Static app:UiText.HistoryTitle}"/>
                    <Border Style="{StaticResource IrisRowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="TextBulletListAdd20" Style="{StaticResource IrisRowIcon}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.HistoryEnabled}"/>
                                <TextBlock Style="{StaticResource IrisRowDescription}" Text="{x:Static app:UiText.HistoryEnabledHelp}"/>
                            </StackPanel>
                            <CheckBox x:Name="HistoryEnabledCheckBox" Grid.Column="2" Style="{StaticResource IrisSwitchCheckBox}" Margin="{StaticResource IrisControlGap}" VerticalAlignment="Center" IsChecked="{Binding History.Enabled.Value}" AutomationProperties.Name="{x:Static app:UiText.HistoryEnabled}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource IrisRowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="NumberSymbol20" Style="{StaticResource IrisRowIcon}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IrisRowTitle}" Text="{x:Static app:UiText.HistoryMaxLabel}"/>
                                <TextBlock Style="{StaticResource IrisRowDescription}" Text="{x:Static app:UiText.HistoryMaxHelp}"/>
                                <TextBlock Style="{StaticResource IrisRowError}" Text="{Binding History.ErrorMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
