<ui:FluentWindow x:Class="Iris.App.Settings.SettingsWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:Iris.App"
                 xmlns:settings="clr-namespace:Iris.Core.Settings;assembly=Iris.Core"
                 xmlns:local="clr-namespace:Iris.App.Settings"
                 Title="{x:Static app:UiText.SettingsWindowTitle}"
                 Width="760"
                 Height="520"
                 MinWidth="600"
                 MinHeight="440"
                 WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static app:UiText.SettingsWindowTitle}"
                     ShowMaximize="False" />

        <!-- 主体区域：左侧导航与右侧内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    Padding="6,12,6,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{x:Static app:UiText.SettingsTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="8,0,0,12" />

                    <!-- 导航项：常规 -->
                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonUp="OnNavGeneralClick">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="general">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{x:Static app:UiText.SettingsNavGeneral}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- 导航项：翻译服务 -->
                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonUp="OnNavTranslationClick">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="translation">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{x:Static app:UiText.SettingsNavTranslation}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- 导航项：快捷键 -->
                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonUp="OnNavHotkeysClick">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="hotkeys">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{x:Static app:UiText.SettingsNavHotkeys}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonUp="OnNavSelectionClick">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="selection">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{x:Static app:UiText.SettingsNavSelection}" FontWeight="Medium" VerticalAlignment="Center" />
                    </Border>
                <Border x:Name="NavOcr" CornerRadius="4" Padding="10,6" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonUp="OnNavOcrClick"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="ocr"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{x:Static app:UiText.OcrPageTitle}" TextWrapping="Wrap" FontWeight="Medium"/></Border><Border x:Name="NavScreenshot" CornerRadius="4" Padding="10,6" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonUp="OnNavScreenshotClick"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="screenshot"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{x:Static app:UiText.ScreenshotPageTitle}" TextWrapping="Wrap" FontWeight="Medium"/></Border>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <ScrollViewer x:Name="OcrPageScroll" Grid.Column="1" Padding="20,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="ocr">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <TextBlock Text="{x:Static app:UiText.OcrPageTitle}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Static app:UiText.OcrPageDescription}" TextWrapping="Wrap" Margin="0,6,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="{x:Static app:UiText.OcrPrimary}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                        <ComboBox x:Name="OcrPrimaryCombo" ItemsSource="{Binding OcrActiveChoices}" SelectedValue="{Binding Ocr.ActiveProviderId.Value, Mode=TwoWay}" SelectedValuePath="Id" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <TextBlock Text="{x:Static app:UiText.OcrFallbackLabel}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                        <ComboBox x:Name="OcrFallbackCombo" ItemsSource="{Binding OcrFallbackChoices}" SelectedValue="{Binding Ocr.FallbackProviderId.Value, Mode=TwoWay}" SelectedValuePath="Id" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <TextBlock Text="{x:Static app:UiText.OcrLayout}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                        <ComboBox x:Name="OcrLayoutCombo" ItemsSource="{x:Static local:OcrSettingsDraftViewModel.Layouts}" SelectedValue="{Binding Ocr.TextLayout.Value, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                        <TextBlock Text="{x:Static app:UiText.OcrLanguageHint}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                        <TextBox x:Name="OcrLanguageHintTextBox" Text="{Binding Ocr.LanguageHint.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="OcrAutoCopyCheck" IsChecked="{Binding Ocr.AutoCopyOnOcr.Value, Mode=TwoWay}" Margin="0,5,0,5">
                            <TextBlock Text="{x:Static app:UiText.OcrCopySource}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="OcrSilentNotifyCheck" IsChecked="{Binding Ocr.SilentOcrShowNotification.Value, Mode=TwoWay}" Margin="0,5,0,5">
                            <TextBlock Text="{x:Static app:UiText.OcrNotifySilent}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock x:Name="OcrSelectionError" Text="{Binding Ocr.ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        <Separator Margin="0,12,0,12"/>
                        <TextBlock Text="{x:Static app:UiText.OcrServices}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                        <WrapPanel>
                            <Button Content="{x:Static app:UiText.OcrAddBaidu}" Command="{Binding AddBaiduOcrCommand}" Margin="0,0,8,8"/>
                            <Button Content="{x:Static app:UiText.OcrAddWindows}" Command="{Binding AddWindowsOcrCommand}" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <ListBox x:Name="OcrProfilesListBox" ItemsSource="{Binding OcrProfiles}" SelectedItem="{Binding SelectedOcrProfile, Mode=TwoWay}" MaxHeight="120" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName.Value}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="DeleteOcrProfileButton" Content="{x:Static app:UiText.OcrDelete}" Command="{Binding DeleteOcrProfileCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <StackPanel x:Name="OcrDetailsPanel" DataContext="{Binding SelectedOcrProfile}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{x:Static app:UiText.OcrName}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                            <TextBox x:Name="OcrNameTextBox" Text="{Binding DisplayName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="OcrEnabledCheck" IsChecked="{Binding Enabled.Value, Mode=TwoWay}" Margin="0,5,0,5">
                                <TextBlock Text="{x:Static app:UiText.OcrEnabled}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Text="{x:Static app:UiText.OcrTimeout}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                            <TextBox x:Name="OcrTimeoutTextBox" Text="{Binding TimeoutText.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="OcrBaiduOptionsPanel" Visibility="{Binding IsBaidu, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Static app:UiText.OcrMode}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                                <ComboBox x:Name="OcrModeCombo" ItemsSource="{x:Static local:OcrProfileDraftViewModel.Modes}" SelectedValue="{Binding Mode.Value, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                                <CheckBox x:Name="OcrDirectionCheck" IsChecked="{Binding DetectDirection.Value, Mode=TwoWay}" Margin="0,5,0,5">
                                    <TextBlock Text="{x:Static app:UiText.OcrDetectDirection}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox x:Name="OcrParagraphCheck" IsChecked="{Binding Paragraph.Value, Mode=TwoWay}" Margin="0,5,0,5">
                                    <TextBlock Text="{x:Static app:UiText.OcrParagraph}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <TextBlock Text="{x:Static app:UiText.OcrLanguageType}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                                <TextBox x:Name="OcrLanguageTypeTextBox" Text="{Binding LanguageType.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                <TextBlock Text="{x:Static app:UiText.OcrBaseUrl}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                                <TextBox x:Name="OcrBaseUrlTextBox" Text="{Binding BaseUrl.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            </StackPanel>
                            <StackPanel x:Name="OcrWindowsOptionsPanel" Visibility="{Binding IsWindows, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Static app:UiText.OcrLanguageTag}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                                <TextBox x:Name="OcrLanguageTagTextBox" Text="{Binding LanguageTag.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static app:UiText.OcrCredentials}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                            <ComboBox x:Name="OcrCredentialCombo" ItemsSource="{Binding CredentialOptions}" SelectedValue="{Binding Credentials.Value, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                            <TextBlock Text="{Binding CredentialDescription}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Visibility="{Binding IsBaidu, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsReplacing}">
                                <TextBlock Text="{x:Static app:UiText.OcrApiKey}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                                <PasswordBox x:Name="OcrApiKeyPasswordBox" PasswordChanged="OnOcrPasswordChanged" Margin="0,0,0,8"/>
                                <TextBlock Text="{x:Static app:UiText.OcrSecretKey}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                                <PasswordBox x:Name="OcrSecretKeyPasswordBox" PasswordChanged="OnOcrPasswordChanged" Margin="0,0,0,8"/>
                            </StackPanel>
                            <TextBlock x:Name="OcrProfileError" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <WrapPanel Margin="0,12,0,6">
                        <Button x:Name="OcrTestButton" Content="{x:Static app:UiText.OcrTest}" Command="{Binding TestOcrCommand}" Margin="0,0,8,6"/>
                        <Button x:Name="OcrCancelTestButton" Content="{x:Static app:UiText.OcrCancelTest}" Command="{Binding CancelOcrTestCommand}" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock x:Name="OcrTestResultText" Text="{Binding SelectedOcrProfile.TestMessage}" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Static app:UiText.OcrTestDescription}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="ScreenshotPageScroll" Grid.Column="1" Padding="20,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="screenshot">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <TextBlock Text="{x:Static app:UiText.ScreenshotPageTitle}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Static app:UiText.ScreenshotSettingsDescription}" TextWrapping="Wrap" Margin="0,6,0,18" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <CheckBox x:Name="ScreenshotConfirmCheck" IsChecked="{Binding Screenshot.ConfirmOnMouseUp.Value, Mode=TwoWay}" Margin="0,5,0,5">
                            <TextBlock Text="{x:Static app:UiText.ScreenshotConfirmOnMouseUp}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="ScreenshotMagnifierCheck" IsChecked="{Binding Screenshot.ShowMagnifier.Value, Mode=TwoWay}" Margin="0,5,0,5">
                            <TextBlock Text="{x:Static app:UiText.ScreenshotShowMagnifier}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="ScreenshotHideCheck" IsChecked="{Binding Screenshot.HideIrisWindows.Value, Mode=TwoWay}" Margin="0,5,0,5">
                            <TextBlock Text="{x:Static app:UiText.ScreenshotHideWindows}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="ScreenshotCopyCheck" IsChecked="{Binding Screenshot.CopyImageToClipboard.Value, Mode=TwoWay}" Margin="0,5,0,5">
                            <TextBlock Text="{x:Static app:UiText.ScreenshotCopyImage}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock Text="{x:Static app:UiText.ScreenshotOpacity}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                        <TextBox x:Name="ScreenshotMaskOpacityTextBox" Text="{Binding Screenshot.MaskOpacityText.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ScreenshotError" Text="{Binding Screenshot.ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <!-- 右侧常规设置内容 -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,16,24,16">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="general">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="600" HorizontalAlignment="Left" IsEnabled="{Binding CanEdit}">
                    <!-- 页面标题 -->
                    <TextBlock Text="{x:Static app:UiText.SettingsNavGeneral}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20" />

                    <!-- 外观与主题卡片 -->
                    <ui:Card Margin="0,0,0,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{x:Static app:UiText.SettingsThemeGroup}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{x:Static app:UiText.SettingsThemeDescription}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,12" />
                            <ComboBox SelectedValue="{Binding Theme, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      IsEnabled="{Binding CanEdit}"
                                      Width="200"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Tag="{x:Static settings:AppTheme.System}"
                                              Content="{x:Static app:UiText.SettingsThemeSystem}" />
                                <ComboBoxItem Tag="{x:Static settings:AppTheme.Light}"
                                              Content="{x:Static app:UiText.SettingsThemeLight}" />
                                <ComboBoxItem Tag="{x:Static settings:AppTheme.Dark}"
                                              Content="{x:Static app:UiText.SettingsThemeDark}" />
                            </ComboBox>
                        </StackPanel>
                    </ui:Card>

                    <!-- 系统启动与通知卡片 -->
                    <ui:Card Margin="0,0,0,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{x:Static app:UiText.SettingsStartupGroup}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEdit}"
                                      Content="{x:Static app:UiText.SettingsLaunchAtStartup}"
                                      Margin="0,4,0,8" />
                            <CheckBox IsChecked="{Binding ShowStartupNotification, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEdit}"
                                      Content="{x:Static app:UiText.SettingsShowStartupNotification}"
                                      Margin="0,4,0,4" />
                        </StackPanel>
                    </ui:Card>

                    <!-- 日志级别卡片 -->
                    <ui:Card Margin="0,0,0,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{x:Static app:UiText.SettingsLogGroup}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{x:Static app:UiText.SettingsLogDescription}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,12" />
                            <ComboBox SelectedValue="{Binding LogLevel, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      IsEnabled="{Binding CanEdit}"
                                      Width="200"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="Verbose" />
                                <ComboBoxItem Content="Debug" />
                                <ComboBoxItem Content="Information" />
                                <ComboBoxItem Content="Warning" />
                                <ComboBoxItem Content="Error" />
                            </ComboBox>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧翻译服务设置内容 -->
            <Grid x:Name="TranslationLayoutGrid"
                  Grid.Column="1"
                  Margin="12,12,12,12">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="translation">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ProfilesColDef" Width="220" />
                    <ColumnDefinition x:Name="DetailsColDef" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ProfilesRowDef" Height="*" />
                    <RowDefinition x:Name="DetailsRowDef" Height="0" />
                </Grid.RowDefinitions>

                <!-- 服务列表列 -->
                <Grid x:Name="ProfilesPane"
                      Grid.Row="0"
                      Grid.Column="0"
                      Margin="0,0,10,0"
                      IsEnabled="{Binding CanEdit}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 添加服务按钮与预设菜单 -->
                        <ui:Button Grid.Column="0"
                                   x:Name="AddProfileButton"
                                   Content="{x:Static app:UiText.SettingsAddProfile}"
                                   Click="OnAddProfileButtonClick"
                                   HorizontalAlignment="Stretch"
                                   MinWidth="0"
                                   Padding="4,2"
                                   Margin="0,0,4,0" />

                        <!-- 操作按钮：上移、下移、删除 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button x:Name="MoveUpProfileButton"
                                       Content="{x:Static app:UiText.SettingsMoveUp}"
                                       Command="{Binding MoveUpCommand}"
                                       MinWidth="0"
                                       Padding="3,2"
                                       Margin="0,0,2,0" />
                            <ui:Button x:Name="MoveDownProfileButton"
                                       Content="{x:Static app:UiText.SettingsMoveDown}"
                                       Command="{Binding MoveDownCommand}"
                                       MinWidth="0"
                                       Padding="3,2"
                                       Margin="0,0,2,0" />
                            <ui:Button x:Name="DeleteProfileButton"
                                       Content="{x:Static app:UiText.SettingsDeleteProfile}"
                                       Command="{Binding DeleteProfileCommand}"
                                       MinWidth="0"
                                       Padding="4,2" />
                        </StackPanel>
                    </Grid>

                    <!-- 服务列表 -->
                    <ListBox x:Name="ProfilesListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             SelectionMode="Single"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnProfilesListPreviewMouseLeftButtonDown"
                             MouseMove="OnProfilesListMouseMove"
                             DragOver="OnProfilesListDragOver"
                             Drop="OnProfilesListDrop"
                             SelectionChanged="OnProfileSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Model}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- 选定服务详情列 -->
                <ScrollViewer x:Name="DetailsPane"
                              Grid.Row="0"
                              Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="4,0,4,0">
                    <StackPanel DataContext="{Binding SelectedProfile}"
                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- 基本配置卡片 -->
                        <ui:Card Margin="0,0,0,12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="基本信息" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:UiText.SettingsProfileName}" Width="75" VerticalAlignment="Center" />
                                    <TextBox x:Name="DisplayNameTextBox" Grid.Column="1" Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:UiText.SettingsProfileKind}" Width="75" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:UiText.SettingsProfileBaseUrl}" Width="75" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <!-- Anthropic /v1 提示 -->
                                <TextBlock Text="{x:Static app:UiText.SettingsAnthropicV1Warning}"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           FontSize="11"
                                           Margin="75,0,0,8"
                                           Visibility="{Binding HasAnthropicV1Warning, Converter={StaticResource BoolToVis}}"
                                           TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:UiText.SettingsProfileModel}" Width="75" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox Grid.Column="1"
                                                  Width="24"
                                                  ItemsSource="{Binding AvailableModels}"
                                                  SelectedItem="{Binding Model, Mode=TwoWay}"
                                                  Margin="4,0,0,0" />
                                    </Grid>
                                </Grid>

                                <!-- 测试与获取模型按钮 -->
                                <WrapPanel Orientation="Horizontal" Margin="75,4,0,4">
                                    <ui:Button Content="{x:Static app:UiText.SettingsListDraftModels}"
                                               Command="{Binding DataContext.ListModelsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Margin="0,0,8,4" />
                                    <ui:Button Content="{x:Static app:UiText.SettingsTestDraft}"
                                               Command="{Binding DataContext.TestDraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Margin="0,0,0,4" />
                                </WrapPanel>

                                <!-- 测试与列表状态展示 -->
                                <StackPanel Margin="75,4,0,0">
                                    <TextBlock Text="{Binding ListModelsStatusMessage}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding TestStatusMessage}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,2">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TestSuccess}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding TestSampleTranslation}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- 凭据设置卡片 -->
                        <ui:Card Margin="0,0,0,12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="凭据管理" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                                <ComboBox SelectedValue="{Binding CredentialEditKind, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          MaxWidth="260"
                                          HorizontalAlignment="Left"
                                          Margin="0,0,0,8">
                                    <ComboBoxItem Tag="{x:Static settings:CredentialEditKind.Keep}"
                                                  Content="{x:Static app:UiText.SettingsCredKeep}" />
                                    <ComboBoxItem Tag="{x:Static settings:CredentialEditKind.Replace}"
                                                  Content="{x:Static app:UiText.SettingsCredReplace}" />
                                    <ComboBoxItem Tag="{x:Static settings:CredentialEditKind.Clear}"
                                                  Content="{x:Static app:UiText.SettingsCredClear}" />
                                </ComboBox>

                                <Grid Margin="0,4,0,0" IsEnabled="{Binding IsReplaceCredential}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:UiText.SettingsProfileApiKey}" Width="75" VerticalAlignment="Center" />
                                    <PasswordBox Grid.Column="1"
                                                 x:Name="ApiKeyPasswordBox"
                                                 PasswordChanged="OnApiKeyPasswordChanged" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- 生成参数卡片 -->
                        <ui:Card Margin="0,0,0,12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="请求参数" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:UiText.SettingsProfileTimeout}" Width="95" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding TimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:UiText.SettingsProfileMaxTokens}" Width="95" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding MaxOutputTokensText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
                                </Grid>

                                <Grid Margin="0,0,0,8" Visibility="{Binding IsTemperatureVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:UiText.SettingsProfileTemperature}" Width="95" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding TemperatureText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:UiText.SettingsProfilePrompt}" Width="95" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DataContext.AvailablePrompts, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding PromptTemplateId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="DisplayName"
                                              MaxWidth="240"
                                              HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- 高级选项卡片 -->
                        <Expander x:Name="AdvancedOptionsExpander" Header="{x:Static app:UiText.SettingsProfileAdvanced}" Margin="0,0,0,16">
                            <StackPanel Margin="0,8,0,0">
                                <!-- OpenAI 兼容高级项 -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static settings:TranslationProviderKind.OpenAICompatible}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <CheckBox Content="{x:Static app:UiText.SettingsStream}"
                                              IsChecked="{Binding Stream, Mode=TwoWay}"
                                              Margin="0,0,0,8" />
                                    <CheckBox Content="{x:Static app:UiText.SettingsIncludeStreamUsage}"
                                              IsChecked="{Binding IncludeStreamUsage, Mode=TwoWay}"
                                              Margin="0,0,0,8" />
                                    <CheckBox Content="{x:Static app:UiText.SettingsStripThinkTags}"
                                              IsChecked="{Binding StripThinkTags, Mode=TwoWay}"
                                              Margin="0,0,0,8" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static app:UiText.SettingsMaxTokensField}" Width="120" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedValue="{Binding MaxTokensField, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  MaxWidth="200"
                                                  HorizontalAlignment="Left">
                                            <ComboBoxItem Tag="{x:Static settings:MaxTokensField.MaxTokens}"
                                                          Content="max_tokens (默认)" />
                                            <ComboBoxItem Tag="{x:Static settings:MaxTokensField.MaxCompletionTokens}"
                                                          Content="max_completion_tokens (推理)" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static app:UiText.SettingsChatCompletionsPath}"
                                                   Width="120"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{x:Static app:UiText.SettingsChatCompletionsPath}" />
                                        <TextBox Grid.Column="1" Text="{Binding ChatCompletionsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <TextBlock Text="{x:Static app:UiText.SettingsExtraHeaders}" Margin="0,4,0,4" />
                                    <TextBox Text="{Binding ExtraHeadersText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             Height="60"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" />
                                </StackPanel>

                                <!-- Anthropic 高级项 -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static settings:TranslationProviderKind.Anthropic}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static app:UiText.SettingsEffort}" Width="120" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedValue="{Binding Effort, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  MaxWidth="140"
                                                  HorizontalAlignment="Left">
                                            <ComboBoxItem Tag="{x:Null}" Content="默认 (null)" />
                                            <ComboBoxItem Tag="low" Content="low" />
                                            <ComboBoxItem Tag="medium" Content="medium" />
                                            <ComboBoxItem Tag="high" Content="high" />
                                            <ComboBoxItem Tag="xhigh" Content="xhigh" />
                                            <ComboBoxItem Tag="max" Content="max" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Haiku Effort 提示 -->
                                    <TextBlock Text="{x:Static app:UiText.SettingsHaikuEffortWarning}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               FontSize="11"
                                               Margin="120,0,0,8"
                                               Visibility="{Binding HasHaikuEffortWarning, Converter={StaticResource BoolToVis}}"
                                               TextWrapping="Wrap" />

                                    <CheckBox Content="{x:Static app:UiText.SettingsRefusalFallback}"
                                              IsChecked="{Binding RefusalFallback, Mode=TwoWay}"
                                              Margin="0,0,0,8" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <ScrollViewer x:Name="SelectionScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="24,16">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="selection">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="{x:Static app:UiText.SettingsNavSelection}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock x:Name="SelectionErrorTextBlock" Text="{Binding Selection.ErrorMessage}" TextWrapping="Wrap"
                               Visibility="{Binding Selection.HasError, Converter={StaticResource BoolToVis}}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,0,12" />
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static app:UiText.MouseModeLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ComboBox x:Name="MouseModeComboBox" ItemsSource="{x:Static local:SelectionSettingsDraftViewModel.MouseModes}"
                                      DisplayMemberPath="Label" SelectedValuePath="Mode" SelectedValue="{Binding Selection.MouseMode, Mode=TwoWay}" />
                            <TextBlock Text="{x:Static app:UiText.MouseExplanation}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <CheckBox Content="{x:Static app:UiText.MouseBeamLabel}" IsChecked="{Binding Selection.RequireIBeamCursor, Mode=TwoWay}" Margin="0,0,0,12" />
                            <TextBlock Text="{x:Static app:UiText.MouseDragLabel}" Margin="0,0,0,6" />
                            <TextBox x:Name="MouseDragTextBox" Text="{Binding Selection.MinDragDistanceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140" HorizontalAlignment="Left" Margin="0,0,0,12" />
                            <TextBlock Text="{x:Static app:UiText.MouseHideLabel}" Margin="0,0,0,6" />
                            <TextBox x:Name="MouseHideTextBox" Text="{Binding Selection.IconAutoHideText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140" HorizontalAlignment="Left" Margin="0,0,0,12" />
                            <TextBlock Text="{x:Static app:UiText.MouseExcludedLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="MouseExcludedTextBox" Text="{Binding Selection.ExcludedProcessesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="130" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static app:UiText.SelectionOrderLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ComboBox x:Name="SelectionOrderComboBox" ItemsSource="{x:Static local:SelectionSettingsDraftViewModel.Orders}"
                                      DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Selection.ReadOrderChoice, Mode=TwoWay}" />
                            <TextBlock Text="{x:Static app:UiText.SelectionSafetyDescription}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,12" />
                            <TextBlock Text="{x:Static app:UiText.SelectionTimeoutLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBox x:Name="SelectionTimeoutTextBox" Text="{Binding Selection.ClipboardTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140" HorizontalAlignment="Left" />
                            <TextBlock Text="{x:Static app:UiText.SelectionTimeoutDescription}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Content="{x:Static app:UiText.SelectionRestoreLabel}" IsChecked="{Binding Selection.RestoreClipboard, Mode=TwoWay}" />
                            <TextBlock Text="{x:Static app:UiText.SelectionRestoreDescription}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,16" />
                            <CheckBox Content="{x:Static app:UiText.SelectionEmptyLabel}" IsChecked="{Binding Selection.OpenInputWhenEmpty, Mode=TwoWay}" />
                            <TextBlock Text="{x:Static app:UiText.SelectionEmptyDescription}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static app:UiText.SelectionProcessesLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="{x:Static app:UiText.SelectionProcessesDescription}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" />
                            <TextBox x:Name="SelectionProcessesTextBox" Text="{Binding Selection.ClipboardUnsafeProcessesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="130" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧快捷键设置内容 -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,16,24,16">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="hotkeys">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="600" HorizontalAlignment="Left" IsEnabled="{Binding CanAccessHotkeysTab}">
                    <!-- 页面标题 -->
                    <TextBlock Text="{x:Static app:UiText.SettingsNavHotkeys}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{x:Static app:UiText.SettingsHotkeysDescription}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               Margin="0,0,0,16" />

                    <!-- 快捷键卡片列表 -->
                    <ItemsControl ItemsSource="{Binding Hotkeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HotkeyItemDraftViewModel}">
                                <ui:Card Margin="0,0,0,12" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 第一行：名称、描述与启用复选框 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14" />
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           FontSize="12"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanEdit}"
                                                      Content="{x:Static app:UiText.SettingsHotkeyEnable}"
                                                      VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- 第二行：录入控件 -->
                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <local:HotkeyRecorderBox MinWidth="360" MaxWidth="500" HorizontalAlignment="Left" />
                                        </Grid>

                                        <!-- 第三行：错误与状态提示 -->
                                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                            <!-- 草稿错误（冲突、非法键） -->
                                            <TextBlock Text="{Binding DraftError}"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDraftError}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 运行时注册状态 -->
                                            <TextBlock Text="{Binding RuntimeStatusText}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontSize="12"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasRuntimeStatus}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部状态与操作栏 -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 状态与异常重试提示 -->
                <Grid Grid.ColumnSpan="2" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="StatusMessageTextBlock"
                               Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

<StackPanel Grid.Row="1">                    <TextBlock x:Name="MouseRuntimeStatusTextBlock" Grid.Row="1" Text="{Binding MouseRuntimeStatus}" TextWrapping="Wrap"
                               Margin="0,4,0,4" Visibility="{Binding HasMouseRuntimeStatus, Converter={StaticResource BoolToVis}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
<TextBlock x:Name="OcrTestStatusText" Text="{Binding OcrTestStatus}" TextWrapping="Wrap" Margin="0,4,0,4" Visibility="{Binding HasOcrTestStatus, Converter={StaticResource BoolToVis}}"/></StackPanel>
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="OcrRetryCleanupButton" Content="{x:Static app:UiText.OcrRetryCleanup}" Command="{Binding RetryOcrCleanupCommand}" Margin="0,0,6,0" Visibility="{Binding HasFailedOcrCleanup, Converter={StaticResource BoolToVis}}"/>
                        <!-- 保存冲突时展示“重新载入”按钮 -->
                        <Button Content="{x:Static app:UiText.SettingsReload}"
                                Command="{Binding ReloadCommand}"
                                Margin="0,0,6,0" Visibility="{Binding IsConflict, Converter={StaticResource BoolToVis}}" />

                        <!-- 开机启动写入失败时展示“重试应用”按钮 -->
                        <Button Content="{x:Static app:UiText.SettingsRetry}"
                                Command="{Binding RetryAutoStartCommand}"
                                Margin="0,0,6,0" Visibility="{Binding CanRetryAutoStart, Converter={StaticResource BoolToVis}}" />

                        <!-- 服务待应用刷新/清理失败时展示“重试服务应用”按钮 -->
                        <Button Content="{x:Static app:UiText.SettingsRetryPendingApply}"
                                Command="{Binding RetryPendingApplyCommand}"
                                Margin="0,0,6,0" Visibility="{Binding CanRetryPendingApply, Converter={StaticResource BoolToVis}}" />

                        <!-- 快捷键系统注册或录入清理失败时展示“重试快捷键应用”按钮 -->
                        <Button Content="{x:Static app:UiText.SettingsRetryHotkeys}"
                                Command="{Binding RetryHotkeysCommand}" Visibility="{Binding CanRetryHotkeysOrCleanup, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{x:Static app:UiText.MouseRetry}" Command="{Binding RetryMouseCommand}" Margin="6,0,0,0"
                                Visibility="{Binding CanRetryMouse, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>
                </Grid>

                <!-- 操作按钮区 -->
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,8,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <ui:Button Content="{x:Static app:UiText.SettingsCancel}"
                               Command="{Binding CancelCommand}"
                               IsCancel="True"
                               Width="80"
                               Margin="0,0,8,0" />
                    <ui:Button Content="{x:Static app:UiText.SettingsSave}"
                               Command="{Binding SaveCommand}"
                               Click="OnSaveButtonClick"
                               IsDefault="True"
                               Appearance="Primary"
                               Width="80" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
