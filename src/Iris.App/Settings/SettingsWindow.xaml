<ui:FluentWindow x:Class="Iris.App.Settings.SettingsWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:Iris.App"
                 xmlns:settings="clr-namespace:Iris.Core.Settings;assembly=Iris.Core"
                 Title="{x:Static app:UiText.SettingsWindowTitle}"
                 Width="760"
                 Height="520"
                 MinWidth="600"
                 MinHeight="440"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static app:UiText.SettingsWindowTitle}"
                     ShowMaximize="False" />

        <!-- 主体区域：左侧导航与右侧内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    Padding="8,16,8,8">
                <StackPanel>
                    <TextBlock Text="{x:Static app:UiText.SettingsTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="12,0,0,16" />
                    <!-- 导航项：常规（本单仅开放常规项） -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Padding="12,8">
                        <TextBlock Text="{x:Static app:UiText.SettingsNavGeneral}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 右侧常规设置内容 -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,16,24,16">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left" IsEnabled="{Binding CanEdit}">
                    <!-- 页面标题 -->
                    <TextBlock Text="{x:Static app:UiText.SettingsNavGeneral}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20" />

                    <!-- 外观与主题卡片 -->
                    <ui:Card Margin="0,0,0,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{x:Static app:UiText.SettingsThemeGroup}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{x:Static app:UiText.SettingsThemeDescription}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,12" />
                            <ComboBox SelectedValue="{Binding Theme, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      IsEnabled="{Binding CanEdit}"
                                      Width="200"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Tag="{x:Static settings:AppTheme.System}"
                                              Content="{x:Static app:UiText.SettingsThemeSystem}" />
                                <ComboBoxItem Tag="{x:Static settings:AppTheme.Light}"
                                              Content="{x:Static app:UiText.SettingsThemeLight}" />
                                <ComboBoxItem Tag="{x:Static settings:AppTheme.Dark}"
                                              Content="{x:Static app:UiText.SettingsThemeDark}" />
                            </ComboBox>
                        </StackPanel>
                    </ui:Card>

                    <!-- 系统启动与通知卡片 -->
                    <ui:Card Margin="0,0,0,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{x:Static app:UiText.SettingsStartupGroup}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEdit}"
                                      Content="{x:Static app:UiText.SettingsLaunchAtStartup}"
                                      Margin="0,4,0,8" />
                            <CheckBox IsChecked="{Binding ShowStartupNotification, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEdit}"
                                      Content="{x:Static app:UiText.SettingsShowStartupNotification}"
                                      Margin="0,4,0,4" />
                        </StackPanel>
                    </ui:Card>

                    <!-- 日志级别卡片 -->
                    <ui:Card Margin="0,0,0,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{x:Static app:UiText.SettingsLogGroup}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{x:Static app:UiText.SettingsLogDescription}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,12" />
                            <ComboBox SelectedValue="{Binding LogLevel, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      IsEnabled="{Binding CanEdit}"
                                      Width="200"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="Verbose" />
                                <ComboBoxItem Content="Debug" />
                                <ComboBoxItem Content="Information" />
                                <ComboBoxItem Content="Warning" />
                                <ComboBoxItem Content="Error" />
                            </ComboBox>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部状态与操作栏 -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 状态与异常重试提示 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 保存冲突时展示“重新载入”按钮 -->
                    <Button Content="{x:Static app:UiText.SettingsReload}"
                            Command="{Binding ReloadCommand}"
                            Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 开机启动写入失败时展示“重试应用”按钮 -->
                    <Button Content="{x:Static app:UiText.SettingsRetry}"
                            Command="{Binding RetryAutoStartCommand}"
                            Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanRetryAutoStart}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- 操作按钮区 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <ui:Button Content="{x:Static app:UiText.SettingsCancel}"
                               Command="{Binding CancelCommand}"
                               IsCancel="True"
                               Width="84"
                               Margin="0,0,8,0" />
                    <ui:Button Content="{x:Static app:UiText.SettingsSave}"
                               Command="{Binding SaveCommand}"
                               IsDefault="True"
                               Appearance="Primary"
                               Width="84" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
